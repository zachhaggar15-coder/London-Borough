# Copy this file to .env.local and fill in the values you need.

# === Map tiles ===
# MapTiler free tier: https://www.maptiler.com/cloud/  (sign up, copy the key)
# If you leave this blank, the app falls back to a no-key demo style that
# rate-limits aggressively. Fine for local dev, not for sharing.
NEXT_PUBLIC_MAPTILER_KEY=

# === Routing + isochrone provider ===
# "static" is the default and uses the reviewed matrix plus clearly labelled
# distance estimates. Set "tfl" only when the deployment can stay within the
# public Journey Planner's traffic limits. Driving-based providers are
# intentionally NOT supported: this app is public-transport-first.
ROUTING_PROVIDER=static
ISOCHRONE_PROVIDER=sampled

# === Convex (Stage 4) ===
# Leave empty until you're ready to add accounts & saved shortlists.
# To enable: run `npx convex dev` and paste the deployment URL it prints.
NEXT_PUBLIC_CONVEX_URL=

# === Optional consent-gated analytics ===
# GA4 is free. Leave blank to keep the optional funnel tracker disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Set true only in local/test environments when inspecting event payloads.
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# === Human-reviewed shortlist experiment ===
# This is deliberately off by default. Enabling it exposes a request form,
# not checkout or payment. Configure a private HTTPS receiver before enabling.
NEXT_PUBLIC_REVIEWED_SHORTLIST_ENABLED=false
REVIEWED_SHORTLIST_WEBHOOK_URL=
